[Desktop Entry]
Type=Application
Name=RUWAC
Comment=Persistent terminals, remote desktops and files
Exec=/usr/bin/ruwac gui
Icon=si.z4.ruwac
Terminal=false
Categories=System;TerminalEmulator;RemoteAccess;
Keywords=terminal;ssh;rdp;remote desktop;multiplexer;screen;tmux;sftp;Codex;Claude;Kimi;
StartupNotify=true
Actions=NewWindow;Update;

[Desktop Action NewWindow]
Name=New window
Exec=/usr/bin/ruwac gui --new-window

[Desktop Action Update]
Name=Install verified update
Exec=/usr/bin/ruwac update --install
